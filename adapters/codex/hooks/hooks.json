{
  "description": "ClauDHD lifecycle, commit reconcile, and post-commit verification hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/brief.js\" --record-visit",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\brief.js\" --record-visit",
            "statusMessage": "Loading ClauDHD cursor"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/checkpoint.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\checkpoint.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hooks/commit-guard.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hooks\\commit-guard.js\"",
            "timeout": 30,
            "statusMessage": "Checking commit gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hooks/commit-verify.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hooks\\commit-verify.js\"",
            "timeout": 30,
            "statusMessage": "Verifying commit"
          }
        ]
      }
    ]
  }
}
